<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>SteamDepotDownload</PackageId>
    <RootNamespace>SteamDepotDownload</RootNamespace>
    <Description>Download Steam game content without the Steam client. Pulls apps, depots and pinned manifests straight from Steam's CDN, with chunk-level incremental updates and per-depot file filtering.</Description>
    <PackageTags>steam;depot;manifest;cdn;steamkit;downloader</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <BaseOutputPath>build\</BaseOutputPath>
    <OutputPath>$(BaseOutputPath)Release\SteamDepotDownload</OutputPath>
    <AssemblyName>SteamDepotDownload</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>

    <DebugType>portable</DebugType>

    <DefaultItemExcludes>$(DefaultItemExcludes);**\obj\**;**\bin\**;build\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="SteamDepotDownload.Steam\SteamDepotDownload.Steam.csproj" PrivateAssets="all" />
    <ProjectReference Include="SteamDepotDownload.App\SteamDepotDownload.App.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="SteamKit2" Version="3.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="**\*.cs" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);AddProjectDllsToPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="AddProjectDllsToPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_SddPackagedAssembly Include="@(ReferenceCopyLocalPaths)"
        Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll' Or '%(ReferenceCopyLocalPaths.Extension)' == '.xml'" />
      <_SddPackagedAssembly Remove="@(_SddPackagedAssembly)"
        Condition="!$([System.String]::Copy('%(Filename)').StartsWith('SteamDepotDownload.'))" />
      <_SddPackagedAssembly Include="@(_SddPackagedAssembly->'%(RootDir)%(Directory)%(Filename).xml')"
        Condition="Exists('%(RootDir)%(Directory)%(Filename).xml')" />
      <BuildOutputInPackage Include="@(_SddPackagedAssembly)" />
    </ItemGroup>
    <Message Importance="high" Text="Packaging: @(_SddPackagedAssembly->'%(Filename)%(Extension)', ', ')" />
  </Target>

</Project>
